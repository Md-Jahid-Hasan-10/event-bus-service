{
  "uid": "banking-logs",
  "title": "Banking - Logs",
  "tags": ["banking"],
  "schemaVersion": 39,
  "version": 1,
  "refresh": "10s",
  "time": { "from": "now-1h", "to": "now" },
  "templating": {
    "list": [
      {
        "name": "service", "label": "Service", "type": "custom",
        "query": "discovery-service,api-gateway,account-service,fund-transfer-service,user-service,core-banking-service,charge-fee-service,otp-service,notification-service,event-bus-service",
        "includeAll": true, "allValue": ".+", "multi": true,
        "current": { "selected": true, "text": ["All"], "value": ["$__all"] },
        "options": []
      },
      {
        "name": "level", "label": "Level", "type": "custom",
        "query": "DEBUG,INFO,WARN,ERROR",
        "includeAll": true, "allValue": ".+", "multi": true,
        "current": { "selected": true, "text": ["All"], "value": ["$__all"] },
        "options": []
      },
      { "name": "transferId", "label": "Transfer id (TXN-...)", "type": "textbox", "query": "", "current": { "text": "", "value": "" } },
      { "name": "search", "label": "Search text", "type": "textbox", "query": "", "current": { "text": "", "value": "" } }
    ]
  },
  "panels": [
    {
      "id": 1, "type": "stat", "title": "Errors (last hour)",
      "datasource": { "type": "loki", "uid": "loki" },
      "gridPos": { "h": 4, "w": 8, "x": 0, "y": 0 },
      "fieldConfig": { "defaults": { "unit": "none", "thresholds": { "mode": "absolute", "steps": [ { "color": "green", "value": null }, { "color": "red", "value": 1 } ] } }, "overrides": [] },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "colorMode": "background", "graphMode": "none", "textMode": "value" },
      "targets": [ { "refId": "A", "queryType": "instant", "expr": "sum(count_over_time({service=~\"$service\", level=\"ERROR\"}[1h])) or vector(0)" } ]
    },
    {
      "id": 2, "type": "stat", "title": "Warnings (last hour)",
      "datasource": { "type": "loki", "uid": "loki" },
      "gridPos": { "h": 4, "w": 8, "x": 8, "y": 0 },
      "fieldConfig": { "defaults": { "unit": "none", "thresholds": { "mode": "absolute", "steps": [ { "color": "green", "value": null }, { "color": "orange", "value": 1 } ] } }, "overrides": [] },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "colorMode": "value", "graphMode": "none", "textMode": "value" },
      "targets": [ { "refId": "A", "queryType": "instant", "expr": "sum(count_over_time({service=~\"$service\", level=\"WARN\"}[1h])) or vector(0)" } ]
    },
    {
      "id": 3, "type": "stat", "title": "Log lines (last hour)",
      "datasource": { "type": "loki", "uid": "loki" },
      "gridPos": { "h": 4, "w": 8, "x": 16, "y": 0 },
      "fieldConfig": { "defaults": { "unit": "none", "thresholds": { "mode": "absolute", "steps": [ { "color": "blue", "value": null } ] } }, "overrides": [] },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "colorMode": "value", "graphMode": "none", "textMode": "value" },
      "targets": [ { "refId": "A", "queryType": "instant", "expr": "sum(count_over_time({service=~\"$service\"}[1h])) or vector(0)" } ]
    },
    {
      "id": 4, "type": "timeseries", "title": "Log lines per minute (by service)",
      "datasource": { "type": "loki", "uid": "loki" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 4 },
      "fieldConfig": { "defaults": { "unit": "none", "min": 0 }, "overrides": [] },
      "targets": [ { "refId": "A", "queryType": "range", "expr": "sum by (service) (count_over_time({service=~\"$service\"}[1m]))", "legendFormat": "{{service}}" } ]
    },
    {
      "id": 5, "type": "timeseries", "title": "Log lines per minute (by level)",
      "datasource": { "type": "loki", "uid": "loki" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 4 },
      "fieldConfig": { "defaults": { "unit": "none", "min": 0 }, "overrides": [] },
      "targets": [ { "refId": "A", "queryType": "range", "expr": "sum by (level) (count_over_time({service=~\"$service\"}[1m]))", "legendFormat": "{{level}}" } ]
    },
    {
      "id": 6, "type": "bargauge", "title": "Warnings and errors per service (last hour)",
      "datasource": { "type": "loki", "uid": "loki" },
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 12 },
      "fieldConfig": { "defaults": { "unit": "none", "min": 0 }, "overrides": [] },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "orientation": "horizontal", "displayMode": "gradient", "showUnfilled": true },
      "targets": [ { "refId": "A", "queryType": "instant", "expr": "sum by (service) (count_over_time({service=~\"$service\", level=~\"WARN|ERROR\"}[1h]))", "legendFormat": "{{service}}" } ]
    },
    {
      "id": 7, "type": "logs", "title": "Logs (filter by service, level, transfer id, or text)",
      "datasource": { "type": "loki", "uid": "loki" },
      "gridPos": { "h": 12, "w": 24, "x": 0, "y": 20 },
      "options": { "showTime": true, "showLabels": false, "showCommonLabels": false, "wrapLogMessage": true, "prettifyLogMessage": true, "enableLogDetails": true, "dedupStrategy": "none", "sortOrder": "Descending" },
      "targets": [ { "refId": "A", "queryType": "range", "expr": "{service=~\"$service\", level=~\"$level\"} |= \"$transferId\" |= \"$search\"", "maxLines": 300 } ]
    },
    {
      "id": 8, "type": "logs", "title": "Latest warnings and errors",
      "datasource": { "type": "loki", "uid": "loki" },
      "gridPos": { "h": 10, "w": 24, "x": 0, "y": 32 },
      "options": { "showTime": true, "showLabels": true, "showCommonLabels": false, "wrapLogMessage": true, "prettifyLogMessage": true, "enableLogDetails": true, "dedupStrategy": "none", "sortOrder": "Descending" },
      "targets": [ { "refId": "A", "queryType": "range", "expr": "{service=~\"$service\", level=~\"WARN|ERROR\"}", "maxLines": 100 } ]
    }
  ]
}